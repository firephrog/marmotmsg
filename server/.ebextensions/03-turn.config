# The TURN relay set up by .platform/hooks/postdeploy/20-turn.sh: where it leaves its address and
# secret for the app, and the ports it needs.
option_settings:
  aws:elasticbeanstalk:application:environment:
    TURN_CONFIG: /etc/marmot/turn.json
Resources:
  turnUdpIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: {"Fn::GetAtt": ["AWSEBSecurityGroup", "GroupId"]}
      IpProtocol: udp
      FromPort: 3478
      ToPort: 3478
      CidrIp: 0.0.0.0/0
  turnTcpIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: {"Fn::GetAtt": ["AWSEBSecurityGroup", "GroupId"]}
      IpProtocol: tcp
      FromPort: 3478
      ToPort: 3478
      CidrIp: 0.0.0.0/0
  turnTlsIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: {"Fn::GetAtt": ["AWSEBSecurityGroup", "GroupId"]}
      IpProtocol: tcp
      FromPort: 5349
      ToPort: 5349
      CidrIp: 0.0.0.0/0
  turnRelayIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: {"Fn::GetAtt": ["AWSEBSecurityGroup", "GroupId"]}
      IpProtocol: udp
      FromPort: 49152
      ToPort: 49252
      CidrIp: 0.0.0.0/0
