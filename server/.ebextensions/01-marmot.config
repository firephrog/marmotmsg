# The database lives outside /var/app/current, so redeploying the app keeps it.
# It does not survive the instance being replaced: this is a single-instance
# beta on SQLite. Moving to RDS is step 6 in marmot.md.
commands:
  01_data_dir:
    command: mkdir -p /var/marmot-data && chown webapp:webapp /var/marmot-data && chmod 700 /var/marmot-data
