# Opens port 443 for the https server set up by .platform/hooks/postdeploy/10-https.sh.
Resources:
  httpsIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: {"Fn::GetAtt": ["AWSEBSecurityGroup", "GroupId"]}
      IpProtocol: tcp
      FromPort: 443
      ToPort: 443
      CidrIp: 0.0.0.0/0
# Hooks must be executable with Unix line endings; a bundle built on Windows keeps neither.
container_commands:
  01_hooks:
    command: find .platform/hooks .platform/confighooks -name '*.sh' -exec sed -i 's/\r$//' {} + -exec chmod +x {} +
