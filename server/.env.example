# Copy this file to .env and fill in what you need. .env is git-ignored; never commit it.

# Listen port (default 8080)
# PORT=8080

# Data directory (default server/data)
# MARMOT_DATA=

# 32-byte at-rest database key, hex or base64. Required when NODE_ENV=production.
# In development a key file is generated next to the database instead.
# MARMOT_DB_KEY=

# Set when running behind a load balancer, so rate limits see real client IPs
# TRUST_PROXY=1

# Voice calls. STUN servers, comma-separated (default stun:stun.l.google.com:19302; set empty for none).
# STUN_URLS=
# A TURN relay for callers who cannot connect directly (strict NATs, some mobile networks).
# Use coturn with use-auth-secret; TURN_SECRET is its static-auth-secret. The relay only sees encrypted SRTP.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SECRET=

# Discord bot token (Developer Portal → your app → Bot → Reset Token).
# Leave empty to turn the Discord link off.
DISCORD_TOKEN=
